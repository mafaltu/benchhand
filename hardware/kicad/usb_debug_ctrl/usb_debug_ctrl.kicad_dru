# GENERATED by pcb-ai-kit/kicad/rules_to_kicad.py from rules/generic/*.yaml + usb_relay.yaml
# Do not edit by hand: change the YAML and regenerate. Each rule names its pcb-ai-kit rule id.

(rule "R-C04 via to foreign pad"
  # via to foreign pad >= 0.3 mm
  (condition "A.Type == 'Via' && B.Type == 'Pad' && A.Net != B.Net")
  (constraint clearance (min 0.3mm))
)

(rule "R-C05 via hole to foreign copper"
  # via hole to foreign track >= 0.2 mm
  (condition "A.Type == 'Via'")
  (constraint hole_clearance (min 0.2mm))
)

(rule "R-C07 PTH hole to foreign copper"
  # component PTH hole to foreign track >= 0.35 mm (D-32)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.35mm))
)

(rule "R-C06 hole to hole with a component PTH"
  # hole-to-hole: via >= 0.25 mm, with a component PTH >= 0.5 mm
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Via'")
  (constraint hole_to_hole (min 0.5mm))
)

(rule "R-V02 one via type"
  # one via type 0.6/0.3 mm; 0.5/0.3 only inside the exposed pad
  (condition "A.Type == 'Via' && !A.intersectsCourtyard('U1')")
  (constraint via_diameter (min 0.6mm) (max 0.6mm))
  (constraint hole_size (min 0.3mm) (max 0.3mm))
  (constraint annular_width (min 0.15mm))
)

(rule "R-V02 exposed-pad vias"
  # U1 EP thermal vias 0.5/0.3 (ring 0.10); other vias near U1 still 0.6/0.3 (checked by R-V02 in checks/)
  (condition "A.Type == 'Via' && A.intersectsCourtyard('U1')")
  (constraint via_diameter (min 0.5mm) (max 0.6mm))
  (constraint hole_size (min 0.3mm) (max 0.3mm))
  (constraint annular_width (min 0.1mm))
)

(rule "R-F06 power track width"
  # track width >= 0.15 mm (fab class); R-G14c SOFT (checker WARN only, D-113); opt = R-G15 0.5mm
  (condition "A.Type == 'Track' && (A.NetName == 'CONTROL_5V' || A.NetName == 'CONTROL_3V3' || A.NetName == 'PASS_IN_5V' || A.NetName == 'PASS_OUT_5V' || A.NetName == '/Relay_Channels/RLY1_COIL_N' || A.NetName == '/Relay_Channels/RLY2_COIL_N' || A.NetName == '/Relay_Channels/RLY3_COIL_N' || A.NetName == '/Relay_Channels/RLY4_COIL_N' || A.NetName == '/Relay_Channels/RLY5_COIL_N' || A.NetName == '/Relay_Channels/K1_COM' || A.NetName == '/Relay_Channels/K1_NC' || A.NetName == '/Relay_Channels/K1_NO' || A.NetName == '/Relay_Channels/K2_COM' || A.NetName == '/Relay_Channels/K2_NC' || A.NetName == '/Relay_Channels/K2_NO' || A.NetName == '/Relay_Channels/K3_COM' || A.NetName == '/Relay_Channels/K3_NC' || A.NetName == '/Relay_Channels/K3_NO' || A.NetName == '/Relay_Channels/K4_COM' || A.NetName == '/Relay_Channels/K4_NC' || A.NetName == '/Relay_Channels/K4_NO' || A.NetName == '/Relay_Channels/K5_COM' || A.NetName == '/Relay_Channels/K5_NC' || A.NetName == '/Relay_Channels/K5_NO' || A.NetName == 'GND')")
  (constraint track_width (min 0.15mm) (opt 0.5mm))
)

