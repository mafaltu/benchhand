  # R-T03/R-T05 class sot
  (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && (A.memberOfFootprint('D403') || A.memberOfFootprint('D404') || A.memberOfFootprint('J101') || A.memberOfFootprint('J201') || A.memberOfFootprint('J202') || A.memberOfFootprint('J203') || A.memberOfFootprint('J204') || A.memberOfFootprint('J205') || A.memberOfFootprint('J301') || A.memberOfFootprint('J401') || A.memberOfFootprint('J402') || A.memberOfFootprint('K201') || A.memberOfFootprint('K202') || A.memberOfFootprint('K203') || A.memberOfFootprint('K204') || A.memberOfFootprint('K205') || A.memberOfFootprint('LED101') || A.memberOfFootprint('LED201') || A.memberOfFootprint('LED202') || A.memberOfFootprint('LED203') || A.memberOfFootprint('LED204') || A.memberOfFootprint('LED205') || A.memberOfFootprint('Q201') || A.memberOfFootprint('Q202') || A.memberOfFootprint('Q203') || A.memberOfFootprint('Q204') || A.memberOfFootprint('Q205') || A.memberOfFootprint('Q401') || A.memberOfFootprint('SW101') || A.memberOfFootprint('SW102') || A.memberOfFootprint('SW103') || A.memberOfFootprint('SW104') || A.memberOfFootprint('SW105') || A.memberOfFootprint('SW106') || A.memberOfFootprint('U101') || A.memberOfFootprint('U102') || A.memberOfFootprint('U104') || A.memberOfFootprint('U311') || A.memberOfFootprint('U321') || A.memberOfFootprint('U331') || A.memberOfFootprint('U341') || A.memberOfFootprint('U401') || A.memberOfFootprint('U402') || A.memberOfFootprint('U403'))")
