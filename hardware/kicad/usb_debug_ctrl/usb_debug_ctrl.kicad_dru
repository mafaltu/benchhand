(rule "R-T01 solid: exposed pad"
  # exposed pad direct (thermal vias, AGENTS)
  (condition "A.Type == 'Pad' && A.memberOfFootprint('U1') && A.Pad_Number == '25'")
  (constraint zone_connection solid)
)

(rule "R-T01 solid: copper-only pads (test pads, solder jumpers)"
  # copper-only pads may be solid (D-37)
  (condition "A.Type == 'Pad' && (A.memberOfFootprint('J102') || A.memberOfFootprint('TP101') || A.memberOfFootprint('TP102') || A.memberOfFootprint('TP103') || A.memberOfFootprint('TP104') || A.memberOfFootprint('TP105') || A.memberOfFootprint('TP106') || A.memberOfFootprint('TP107') || A.memberOfFootprint('TP108') || A.memberOfFootprint('TP109') || A.memberOfFootprint('TP201') || A.memberOfFootprint('TP301') || A.memberOfFootprint('TP401') || A.memberOfFootprint('TP402') || A.memberOfFootprint('TP403') || A.memberOfFootprint('TP404') || A.memberOfFootprint('TP405') || A.memberOfFootprint('TP406') || A.memberOfFootprint('TP407'))")
  (constraint zone_connection solid)
)

(rule "R-T02 spokes"
  # KiCad counts real spokes only; D-99: >= 1 natively (R-T02 >= 2 bridges is SOFT, the bridge current is R-G17 HARD in checks/)
  (condition "A.Type == 'Pad'")
  (constraint min_resolved_spokes 1)
)

(rule "R-S02/R-S03 silk text"
  # R-S02/R-S03
  (layer "?.Silkscreen")
  (condition "A.Type == 'Text' || A.Type == 'Text Box'")
  (constraint text_height (min 1mm))
  (constraint text_thickness (min 0.15mm))
)


# PROJECT-SPECIFIC (round 7, not generated): TC2050 J102 contact pads keep 0.508 mm (drawing note 2) to FOREIGN copper only.
# The local pad clearance of the footprint was removed because the pad-to-pad pitch inside J102 (0.4826 mm) is intrinsic.
(rule "J102 contact pads to foreign copper"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('J102') && !B.memberOfFootprint('J102')")
  (constraint clearance (min 0.508mm))
)

# PROJECT-SPECIFIC (G3 fix r1, not generated; Claude G3 r1 m-9): copper (pour, tracks, pads) keeps 0.3 mm to the J102
# NPTH alignment holes (was 0.2003 mm to the GND pour at NPTH2 (177.71, 4.78)). Re-add if the file is regenerated.
(rule "J102 NPTH to copper"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.memberOfFootprint('J102')")
  (constraint hole_clearance (min 0.3mm))
)

# PROJECT-SPECIFIC (G3 fix r1): J101 NPTH pegs keep 0.25 mm to copper (pour was at 0.2005 mm; the CONTROL_5V A9/B4
# bridge passes the pegs at 0.26 mm, so 0.3 mm is not possible here). J101 own pads (land pattern, 0.224 mm) excluded.
(rule "J101 NPTH to copper"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.memberOfFootprint('J101') && !B.memberOfFootprint('J101')")
  (constraint hole_clearance (min 0.25mm))
)
