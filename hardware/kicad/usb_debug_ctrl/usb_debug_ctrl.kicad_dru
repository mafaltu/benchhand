(rule "R-T03 thermal THT"
  # R-T03/R-T05 class THT (J2, J1 shell)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint thermal_relief_gap (min 0.4mm))
  (constraint thermal_spoke_width (min 0.4mm) (opt 0.4mm) (max 0.4mm))
  (constraint zone_connection thermal_reliefs)
